load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "crypto",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    importpath = "github.com/gnolang/gno/tm2/pkg/crypto",
    visibility = ["//visibility:public"],
    deps = [
        "//tm2/pkg/amino",
        "//tm2/pkg/bech32",
        "//tm2/pkg/crypto/tmhash",
    ],
)

go_test(
    name = "crypto_test",
    srcs = glob(["*_test.go"]),
)

alias(
    name = "go_default_library",
    actual = ":crypto",
    visibility = ["//visibility:public"],
)
