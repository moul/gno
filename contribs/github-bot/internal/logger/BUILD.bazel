load("@io_bazel_rules_go//go:def.bzl", "go_library")

go_library(
    name = "logger",
    srcs = [
        "action.go",
        "logger.go",
        "noop.go",
        "terminal.go",
    ],
    importpath = "github.com/gnolang/gno/contribs/github-bot/internal/logger",
    visibility = ["//contribs/github-bot:__subpackages__"],
    deps = ["@com_github_sethvargo_go_githubactions//:go_default_library"],
)

alias(
    name = "go_default_library",
    actual = ":logger",
    visibility = ["//contribs/github-bot:__subpackages__"],
)
