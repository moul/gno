load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_proto//proto:defs.bzl", "proto_library")

go_library(
    name = "gnolang",
    srcs = glob(
        ["*.go"],
        exclude = [
            "*_test.go",
            "*_filetest.go",
        ],
    ),
    importpath = "github.com/gnolang/gno/gnovm/pkg/gnolang",
    visibility = ["//visibility:public"],
    deps = [
        "//gnovm/pkg/benchops",
        "//gnovm/pkg/gnoenv",
        "//gnovm/pkg/gnolang/internal/softfloat",
        "//gnovm/pkg/gnolang/internal/txlog",
        "//gnovm/pkg/gnomod",
        "//gnovm/pkg/packages",
        "//tm2/pkg/amino",
        "//tm2/pkg/colors",
        "//tm2/pkg/crypto",
        "//tm2/pkg/errors",
        "//tm2/pkg/overflow",
        "//tm2/pkg/regx",
        "//tm2/pkg/std",
        "//tm2/pkg/store",
        "//tm2/pkg/store/utils",
        "//tm2/pkg/strings",
        "@com_github_cockroachdb_apd_v3//:apd",
        "@com_github_davecgh_go_spew//spew",
        "@com_github_pmezard_go_difflib//difflib",
        "@org_golang_x_tools//go/ast/astutil",
        "@org_uber_go_multierr//:multierr",
    ],
)

go_test(
    name = "gnolang_test",
    srcs = glob(["*_test.go"]),
    data = glob(["testdata/**"]),
)

proto_library(
    name = "pb_proto",
    srcs = ["gnolang.proto"],
    visibility = ["//visibility:public"],
    deps = ["@com_google_protobuf//:any_proto"],
)

alias(
    name = "go_default_library",
    actual = ":gnolang",
    visibility = ["//visibility:public"],
)
