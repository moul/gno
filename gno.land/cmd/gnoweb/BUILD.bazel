load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "gnoweb_lib",
    srcs = ["main.go"],
    importpath = "github.com/gnolang/gno/gno.land/cmd/gnoweb",
    visibility = ["//visibility:private"],
    deps = [
        "//gno.land/pkg/gnoweb",
        "//gno.land/pkg/log",
        "//tm2/pkg/commands",
        "@org_uber_go_zap//:zap",
        "@org_uber_go_zap//zapcore",
    ],
)

go_binary(
    name = "gnoweb",
    embed = [":gnoweb_lib"],
    visibility = ["//visibility:public"],
)
